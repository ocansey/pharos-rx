# PHAROS runs end to end with none of these set: the default encoder is fitted
# on the corpus and the default generator is a deterministic offline mock.
# Set a provider only when you want real prose.

# PHAROS_LLM__PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...

# PHAROS_LLM__PROVIDER=openai
# OPENAI_API_KEY=sk-...

# PHAROS_LLM__PROVIDER=ollama
# PHAROS_LLM__MODEL=llama3.1:8b

# Neural encoder instead of the default LSA (needs: pip install '.[encoders]')
# PHAROS_INDEX__ENCODER=sentence-transformers

# Build against all 215,063 reviews instead of the 25,000-review default
# PHAROS_DATA__SAMPLE_SIZE=
