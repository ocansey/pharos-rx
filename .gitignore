# Data — never committed. `pharos fetch-data` retrieves and verifies it.
data/raw/*
data/processed/*
data/index/*
!data/**/.gitkeep

# Evaluation outputs — regenerated by `pharos evaluate`.
artifacts/*.json
!artifacts/.gitkeep

# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/
.env

# Tooling
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
coverage.xml

# Editors / OS
.vscode/
.idea/
.DS_Store
